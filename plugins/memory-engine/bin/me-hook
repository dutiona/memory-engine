#!/bin/sh
# me-hook: the memory-engine client for Claude Code (ADR-0020 §12). Run by a shell, never executed directly.
# Utilities: mkdir mv rm cat date git curl, and the shell's builtins. It never parses JSON.
LC_ALL=C
export LC_ALL
umask 077
unset GIT_DIR GIT_WORK_TREE
ME_VERSION=0.1.0
NL='
'

H=${HOME-}
S=$H/.local/state/memory-engine
O=$S/outbox
TOKEN=$H/.config/memory-engine/secrets/token

usage() {
	printf 'usage: me-hook capture|session-start <me_url> <dev_root> | me-hook flush\n' >&2
	exit 1
}

# heal: recreate every directory of the outbox; a step that failed is then retried once.
heal() {
	mkdir -p "$O/tmp" "$O/seq" "$O/rejected" "$S/bin" 2>/dev/null
}

# printable VALUE: every byte is in 0x21-0x7E.
printable() {
	case $1 in *[!!-~]*) return 1 ;; esac
	return 0
}

# unset_arg VALUE: an option Claude Code passed empty, or left unsubstituted.
unset_arg() {
	case $1 in '' | '${user_config.'*) return 0 ;; esac
	return 1
}

# ---------------------------------------------------------------- project facts (ADR-0020 §3), channel-neutral

# pct VALUE: R := VALUE with every byte outside 0x21-0x7E, and each of % " \, written as %HH.
pct() {
	_s=$1
	case $_s in *[!!-~]* | *[%\"\\]*) ;; *)
		R=$_s
		return 0
		;;
	esac
	R=
	while [ -n "$_s" ]; do
		_r=${_s#?}
		_c=${_s%"$_r"}
		_s=$_r
		case $_c in
		' ') R="$R%20" ;;
		'%') R="$R%25" ;;
		'"') R="$R%22" ;;
		'\') R="$R%5C" ;;
		[!!-~])
			# bash 3.2 prints a byte above 0x7F as a sign-extended FFFFFFFFFFFFFFxx; the last two digits are the byte.
			_h=$(printf %02X "'$_c")
			R="$R%${_h#"${_h%??}"}"
			;;
		*) R=$R$_c ;;
		esac
	done
}

# strip_userinfo URL: R := URL without everything up to its host's last @, in both forms a remote takes.
strip_userinfo() {
	case $1 in
	*://*)
		_sch=${1%%://*}
		_rest=${1#*://}
		_auth=${_rest%%/*}
		_path=${_rest#"$_auth"}
		R=$_sch://${_auth##*@}$_path
		;;
	*:*)
		_pre=${1%%:*}
		case $_pre in
		*/*) R=$1 ;;
		*) R=${_pre##*@}${1#"$_pre"} ;;
		esac
		;;
	*) R=$1 ;;
	esac
}

# facts: F_ROOT F_UPSTREAM F_ORIGIN F_BRANCH from CLAUDE_PROJECT_DIR only; F_OK when there is a project at all.
facts() {
	F_OK= F_ROOT= F_UPSTREAM= F_ORIGIN= F_BRANCH=
	_dir=${CLAUDE_PROJECT_DIR-}
	[ -n "$_dir" ] || return 0
	case $_dir in *"$NL"*) return 0 ;; esac
	[ -d "$_dir" ] || return 0
	F_OK=1
	_out=$(git -C "$_dir" rev-parse --path-format=absolute --git-dir --git-common-dir --show-toplevel </dev/null 2>/dev/null) || {
		F_ROOT=$_dir
		return 0
	}
	_gd=${_out%%"$NL"*}
	_rest=${_out#*"$NL"}
	_cd=${_rest%%"$NL"*}
	_top=${_rest#*"$NL"}
	if [ "$_gd" = "$_cd" ]; then
		F_ROOT=$_top
	else
		case $_cd in
		*/.git) F_ROOT=${_cd%/.git} ;;
		*) F_ROOT=$_top ;;
		esac
	fi
	_b=$(git -C "$_dir" symbolic-ref -q HEAD </dev/null 2>/dev/null) && case $_b in refs/heads/?*) F_BRANCH=${_b#refs/heads/} ;; esac
	_u=$(git -C "$_dir" remote get-url upstream </dev/null 2>/dev/null) && [ -n "$_u" ] && strip_userinfo "$_u" && F_UPSTREAM=$R
	_u=$(git -C "$_dir" remote get-url origin </dev/null 2>/dev/null) && [ -n "$_u" ] && strip_userinfo "$_u" && F_ORIGIN=$R
	return 0
}

# fact_lines: the ME-Project-* header lines, an absent fact omitted.
fact_lines() {
	[ -n "$F_OK" ] || return 0
	pct "$F_ROOT"
	printf 'ME-Project-Root: %s\n' "$R"
	if ! unset_arg "$DEV"; then
		case $DEV in /*) printable "$DEV" && case $DEV in *[%\"\\]*) ;; *) printf 'ME-Project-Dev-Root: %s\n' "$DEV" ;; esac ;; esac
	fi
	[ -z "$F_UPSTREAM" ] || { pct "$F_UPSTREAM" && printf 'ME-Project-Upstream-Url: %s\n' "$R"; }
	[ -z "$F_ORIGIN" ] || { pct "$F_ORIGIN" && printf 'ME-Project-Origin-Url: %s\n' "$R"; }
	[ -z "$F_BRANCH" ] || { pct "$F_BRANCH" && printf 'ME-Project-Branch: %s\n' "$R"; }
	return 0
}

# ---------------------------------------------------------------- enqueue

record_endpoint() {
	unset_arg "$1" && return 0
	_u=${1%/}
	case $_u in http://?* | https://?*) ;; *) return 0 ;; esac
	printable "$_u" || return 0
	_cur=
	[ -f "$O/endpoint" ] && { IFS= read -r _cur <"$O/endpoint" || :; }
	[ "$_u" = "$_cur" ] && return 0
	{ printf '%s\n' "$_u" >"$O/tmp/$$.endpoint" && mv "$O/tmp/$$.endpoint" "$O/endpoint"; } && return 0
	heal
	{ printf '%s\n' "$_u" >"$O/tmp/$$.endpoint" && mv "$O/tmp/$$.endpoint" "$O/endpoint"; } && return 0
	# Never leave the previous URL recorded: a flush would send this event, and the token, there.
	rm -f "$O/tmp/$$.endpoint" "$O/endpoint"
}

abandon() {
	rm -rf "$O/tmp/$$"
	exit 0
}

capture() {
	[ -n "$H" ] || exit 0
	exec 2>/dev/null
	_t=$O/tmp/$$
	[ -e "$_t" ] && rm -rf "$_t"
	mkdir "$_t" || { heal && mkdir "$_t"; } || exit 0
	record_endpoint "$ME_URL"
	facts
	cat >"$_t/body" || abandon
	_d=$(date -u '+%s %Y-%m-%dT%H:%M:%SZ') || abandon
	_ep=${_d%% *}
	_tm=${_d#* }
	case $_ep in '' | *[!0-9]*) abandon ;; esac
	_n=0
	_healed=
	while :; do
		[ "$_n" -lt 1000 ] || abandon
		if mkdir "$O/seq/$_ep.$_n"; then
			_s=000000$_n
			_seq=${_s#"${_s%??????}"}
			_id=$_ep-$_seq-$$
			[ -e "$O/$_id" ] || [ -e "$O/rejected/$_id" ] || break
		elif [ ! -e "$O/seq/$_ep.$_n" ]; then
			[ -z "$_healed" ] || abandon
			_healed=1
			heal
			continue
		fi
		_n=$((_n + 1))
	done
	{
		printf 'ME-Event-Id: %s\n' "$_id"
		printf 'ME-Event-Time: %s\n' "$_tm"
		printf 'ME-Event-Seq: %s\n' "$_seq"
		printf 'ME-Harness: claude-code\n'
		printf 'ME-Client-Version: %s\n' "$ME_VERSION"
		fact_lines
	} >"$_t/headers" || abandon
	mv "$_t" "$O/$_id" || abandon
	exit 0
}

case ${1-} in
capture | session-start)
	SUB=$1
	ME_URL=${2-}
	DEV=${3-}
	capture
	;;
flush) exit 0 ;;
*) usage ;;
esac
